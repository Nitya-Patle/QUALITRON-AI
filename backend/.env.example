# Copy this to .env and fill your values — never commit .env to Git

# Flask
FLASK_ENV=development
JWT_SECRET_KEY=change-this-random-secret

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=qualitron_ai

# Email Alerts (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL=team@company.com

# SMS Alerts (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+1XXXXXXXXXX
ALERT_SMS_TO=+91XXXXXXXXXX

# MQTT / IoT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=factory/sensors/#

# AI Model weights path
MODEL_PATH=ai_engine/weights/yolov8_defect.pt
